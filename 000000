-- Adicionar seletor de cores
função tabAPI:AdicionarSeletorDeCores(opcional)
	opt = opt ou {}

	local UserInputService = game:GetService("UserInputService")
	local TweenService = game:GetService("TweenService")

	nome local = opt.Name ou "Colorpicker"
	local default = opt.Default ou Color3.fromRGB(255, 255, 255)
	local callback = opt.Callback ou function() fim
	flag local = opt.Flag ou HttpService:GenerateGUID(false)

	ElixirLib.Flags[flag] = padrão

	-- base de itens
	item local = novoItemFrame()
	item.Size = UDim2.new(1, -12, 0, 28)
	item.ClipsDescendants = true

	local ALTURA_FECHADA = 28
	local PICHER_HEIGHT = 120
	local OPEN_HEIGHT = CLOSED_HEIGHT + PICLER_HEIGHT + 4

	-- rótulo
	rótulo local = novo("TextLabel", {
		Pai = item,
		Texto = nome,
		Fonte = Enum.Font.GothamBold,
		Tamanho do texto = 12,
		TextColor3 = Tema.ItemText,
		BackgroundTransparency = 1,
		Posição = UDim2.new(0, 8, 0, 0),
		Tamanho = UDim2.new(0.7, -8, 0, 28),
		TextXAlinhamento = Enum.TextXAlinhamento.Esquerda
	})

	-- pré-visualização
	local btn = new("TextButton", {
		Pai = item,
		Texto = "",
		BackgroundColor3 = padrão,
		Tamanho = UDim2.new(0, 42, 0, 18),
		Posição = UDim2.new(1, -56, 0, 5),
		TamanhoBordaPixel = 0,
		AutoButtonColor = falso
	})
	makeCorner(btn, 4)

	local stroke = Instance.new("UIStroke", btn)
	stroke.Color = Tema.AlternarTraçoExternoUI
	espessura do traço = 1

	-- colhedor embutido
	seletor local = novo("Frame", {
		Pai = item,
		BackgroundColor3 = Tema.AlternarExterno,
		Tamanho = UDim2.new(1, -12, 0, 0),
		Posição = UDim2.new(0, 6, 0, 32),
		Tamanho da BordaPixel = 0
	})
	makeCorner(picker, 6)

	-- mapa de cores
	imagem local = novo("RótuloImagem", {
		Pai = seletor,
		Imagem = "rbxassetid://98986117103379",
		BackgroundTransparency = 1,
		Tamanho = UDim2.new(1, 0, 1, 0)
	})

	-- estado
	local aberto = falso
	arrastar local = falso

	-- auxiliar pré-adolescente
	função local tween(obj, props, time)
		TweenService:Criar(
			obj,
			TweenInfo.new(tempo, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			adereços
		):Jogar()
	fim

	-- abrir
	função local openPicker()
		Se estiver aberto, retorne ao fim.
		aberto = verdadeiro
		tween(item, {Size = UDim2.new(1, -12, 0, OPEN_HEIGHT)}, 0.25)
		tween(picker, {Size = UDim2.new(1, -12, 0, PICKER_HEIGHT)}, 0.25)
		stroke.Color = Tema.ItemUIStrokeSelected
	fim

	-- fechar
	função local closePicker()
		Se não estiver aberto, retorne ao fim.
		aberto = falso
		tween(item, {Size = UDim2.new(1, -12, 0, CLOSED_HEIGHT)}, 0.25)
		tween(picker, {Size = UDim2.new(1, -12, 0, 0)}, 0.25)
		stroke.Color = Tema.AlternarTraçoExternoUI
	fim

	--botão preview apenas ABRE
	btn.MouseButton1Down:Conectar(openPicker)

	--conversão fiel ao mapa
	função local setColorFromPosition(pos)
		local x = (pos.X - image.AbsolutePosition.X) / image.AbsoluteSize.X
		local y = (pos.Y - image.AbsolutePosition.Y) / image.AbsoluteSize.Y

		x = math.clamp(x, 0, 1)
		y = math.clamp(y, 0, 1)

		local h = x
		local s, v

		Se y < 0,5 então
			s = y * 2
			v = 1
		outro
			s = 1
			v = 1 - ((y - 0,5) * 2)
		fim

		cor local = Color3.fromHSV(h, s, v)

		ElixirLib.Flags[flag] = cor
		btn.BackgroundColor3 = cor
		callback(cor)
	fim

	-- Início da entrada (PC + CELULAR)
	imagem.InputBegan:Conectar(função(entrada)
		se input.UserInputType == Enum.UserInputType.MouseButton1
		ou input.UserInputType == Enum.UserInputType.Touch então
			arrastar = verdadeiro
			abrirPicker()
			definirCorDaPosição(entrada.Posição)
		fim
	fim)

	-- entrada mover (GLOBAL)
	UserInputService.InputChanged:Connect(function(input)
		Se não estiver arrastando, retorne ao fim.

		se input.UserInputType == Enum.UserInputType.MouseMovement
		ou input.UserInputType == Enum.UserInputType.Touch então
			definirCorDaPosição(entrada.Posição)
		fim
	fim)

	-- final de entrada - FECHA
	UserInputService.InputEnded:Connect(function(input)
		se input.UserInputType == Enum.UserInputType.MouseButton1
		ou input.UserInputType == Enum.UserInputType.Touch então
			se arrastar então
				arrastar = falso
				closePicker()
			fim
		fim
	fim)

	retornar {
		Obter = função()
			retornar ElixirLib.Flags[flag]
		fim,
		Conjunto = função(c)
			se typeof(c) == "Color3" então
				ElixirLib.Flags[flag] = c
				btn.BackgroundColor3 = c
				callback(c)
			fim
		fim,
		Bandeira = bandeira
	}
fim


