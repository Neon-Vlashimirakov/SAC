-- Auxiliar para criar instâncias
função local nova(classe, propriedades)
    local inst = Instance.new(class)
    para k,v em pares(props ou {}) faça
        se k == "Pai" então
            inst.Parent = v
        outro
            pcall(function() inst[k] = v end)
        fim
    fim
    retornar inst
fim

função local makeCorner(pai, raio)
    local c = Instance.new("UICorner")
    c.RaioDoCanto = UDim.new(0, raio ou 4)
    c.Parent = pai
    retornar c
fim

