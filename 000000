                ElixirLib.Flags[flag] = optVal
                currentText.Text = tostring(optVal)
                tarefa.spawn(callback, optVal)
                fecharLista()
            fim)
        fim

        scrollFrame.CanvasSize = UDim2.new(0,0,0,(#options*26)+8)
